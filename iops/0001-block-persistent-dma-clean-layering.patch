diff --git a/block/blk-persistent-dma.c b/block/blk-persistent-dma.c
new file mode 100644
index 000000000000..07a8e1e14f0e
--- /dev/null
+++ b/block/blk-persistent-dma.c
@@ -0,0 +1,292 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Persistent DMA mappings for the block layer.
+ *
+ * Provides a mechanism to DMA-map a buffer once at registration time
+ * and reuse the mapping for every I/O. Used by io_uring registered IO
+ * slots to eliminate per-I/O dma_map / dma_unmap overhead.
+ *
+ * The mapping can be either:
+ *   - IOVA-based (IOMMU coalesces the whole buffer into a single IOVA range)
+ *   - Direct (per-page dma_map_page, stored in seg_addrs[])
+ */
+#include <linux/blk-persistent-dma.h>
+#include <linux/bio.h>
+#include <linux/blkdev.h>
+#include <linux/dma-mapping.h>
+#include <linux/slab.h>
+#include <linux/overflow.h>
+
+struct blk_persistent_dma {
+	struct dma_iova_state	state;
+	dma_addr_t		*seg_addrs;
+	size_t			*seg_lens;	/* per-segment lengths, direct path only */
+	unsigned int		nr_segs;
+	unsigned int		folio_shift;
+	size_t			len;
+	struct device		*dma_dev;
+	enum dma_data_direction	dir;
+
+	void			*driver_priv;
+	void			(*driver_priv_destroy)(struct blk_persistent_dma *dma);
+};
+
+int blk_persistent_dma_map(struct request_queue *q,
+			   const struct bio_vec *bvecs,
+			   unsigned int nr_bvecs,
+			   unsigned int folio_shift,
+			   size_t total_len,
+			   struct blk_persistent_dma **out)
+{
+	struct device *dma_dev = q->dma_dev;
+	struct blk_persistent_dma *dma;
+	const enum dma_data_direction dir = DMA_BIDIRECTIONAL;
+	size_t mapped = 0;
+	unsigned int i;
+	int ret;
+
+	if (!dma_dev)
+		return -EOPNOTSUPP;
+
+	dma = kzalloc(sizeof(*dma), GFP_KERNEL_ACCOUNT);
+	if (!dma)
+		return -ENOMEM;
+
+	dma->dma_dev = dma_dev;
+	dma->dir = dir;
+	dma->nr_segs = nr_bvecs;
+	dma->len = total_len;
+	dma->folio_shift = folio_shift;
+
+	/* IOVA path: coalesce the whole buffer into a single IOVA range. */
+	if (dma_iova_try_alloc(dma_dev, &dma->state,
+			page_to_phys(bvecs[0].bv_page) + bvecs[0].bv_offset,
+			total_len)) {
+		for (i = 0; i < nr_bvecs; i++) {
+			const struct bio_vec *bv = &bvecs[i];
+			phys_addr_t phys =
+				page_to_phys(bv->bv_page) + bv->bv_offset;
+
+			ret = dma_iova_link(dma_dev, &dma->state, phys, mapped,
+					    bv->bv_len, dir, 0);
+			if (ret)
+				goto unlink;
+			mapped += bv->bv_len;
+		}
+		if (dma_iova_sync(dma_dev, &dma->state, 0, mapped)) {
+			ret = -EIO;
+			goto unlink;
+		}
+
+		if (q->persistent_dma_setup) {
+			ret = q->persistent_dma_setup(q, dma);
+			if (ret)
+				goto unlink;
+		}
+
+		*out = dma;
+		return 0;
+
+unlink:
+		while (i-- > 0) {
+			mapped -= bvecs[i].bv_len;
+			dma_iova_unlink(dma_dev, &dma->state, mapped,
+					bvecs[i].bv_len, dir, 0);
+		}
+		dma_iova_free(dma_dev, &dma->state);
+		kfree(dma);
+		return ret;
+	}
+
+	/* Direct path: per-bvec dma_map_page. */
+	dma->seg_addrs = kvmalloc_array(nr_bvecs, sizeof(dma_addr_t),
+					GFP_KERNEL_ACCOUNT);
+	dma->seg_lens = kvmalloc_array(nr_bvecs, sizeof(size_t),
+				       GFP_KERNEL_ACCOUNT);
+	if (!dma->seg_addrs || !dma->seg_lens) {
+		kvfree(dma->seg_addrs);
+		kvfree(dma->seg_lens);
+		kfree(dma);
+		return -ENOMEM;
+	}
+	for (i = 0; i < nr_bvecs; i++) {
+		const struct bio_vec *bv = &bvecs[i];
+		dma_addr_t addr;
+
+		addr = dma_map_page(dma_dev, bv->bv_page, bv->bv_offset,
+				    bv->bv_len, dir);
+		if (dma_mapping_error(dma_dev, addr)) {
+			while (i-- > 0)
+				dma_unmap_page(dma_dev, dma->seg_addrs[i],
+					       dma->seg_lens[i], dir);
+			kvfree(dma->seg_addrs);
+			kvfree(dma->seg_lens);
+			kfree(dma);
+			return -ENOMEM;
+		}
+		dma->seg_addrs[i] = addr;
+		dma->seg_lens[i] = bv->bv_len;
+	}
+
+	if (q->persistent_dma_setup) {
+		ret = q->persistent_dma_setup(q, dma);
+		if (ret) {
+			for (i = 0; i < nr_bvecs; i++)
+				dma_unmap_page(dma_dev, dma->seg_addrs[i],
+					       dma->seg_lens[i], dir);
+			kvfree(dma->seg_addrs);
+			kvfree(dma->seg_lens);
+			kfree(dma);
+			return ret;
+		}
+	}
+
+	*out = dma;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(blk_persistent_dma_map);
+
+void blk_persistent_dma_unmap(struct blk_persistent_dma *dma)
+{
+	unsigned int i;
+
+	if (!dma)
+		return;
+
+	if (dma->driver_priv_destroy)
+		dma->driver_priv_destroy(dma);
+
+	if (dma_use_iova(&dma->state)) {
+		dma_iova_destroy(dma->dma_dev, &dma->state, dma->len,
+				 dma->dir, 0);
+	} else {
+		for (i = 0; i < dma->nr_segs; i++)
+			dma_unmap_page(dma->dma_dev, dma->seg_addrs[i],
+				       dma->seg_lens[i], dma->dir);
+		kvfree(dma->seg_addrs);
+		kvfree(dma->seg_lens);
+	}
+	kfree(dma);
+}
+EXPORT_SYMBOL_GPL(blk_persistent_dma_unmap);
+
+void blk_persistent_dma_sync(struct blk_persistent_dma *dma,
+			     const struct bio *bio,
+			     enum blk_persistent_dma_sync_dir dir)
+{
+	enum dma_data_direction dma_dir;
+	unsigned int idx;
+	size_t off, remaining;
+
+	if (!dma || !dma_dev_need_sync(dma->dma_dev))
+		return;
+
+	dma_dir = bio_data_dir(bio) == WRITE ? DMA_TO_DEVICE : DMA_FROM_DEVICE;
+	idx = bio->bi_iter.bi_idx;
+	off = bio->bi_iter.bi_bvec_done;
+	remaining = bio->bi_iter.bi_size;
+
+	if (dma_use_iova(&dma->state)) {
+		size_t iova_off = blk_persistent_dma_buf_offset(dma, bio);
+		dma_addr_t base = dma->state.addr + iova_off;
+
+		if (dir == BLK_DMA_SYNC_FOR_DEVICE)
+			dma_sync_single_for_device(dma->dma_dev, base,
+						   remaining, dma_dir);
+		else
+			dma_sync_single_for_cpu(dma->dma_dev, base,
+						remaining, dma_dir);
+		return;
+	}
+
+	while (remaining && idx < dma->nr_segs) {
+		size_t seg_avail = bio->bi_io_vec[idx].bv_len - off;
+		size_t to_sync = min_t(size_t, seg_avail, remaining);
+
+		if (dir == BLK_DMA_SYNC_FOR_DEVICE)
+			dma_sync_single_for_device(dma->dma_dev,
+				dma->seg_addrs[idx] + off, to_sync, dma_dir);
+		else
+			dma_sync_single_for_cpu(dma->dma_dev,
+				dma->seg_addrs[idx] + off, to_sync, dma_dir);
+
+		remaining -= to_sync;
+		off = 0;
+		idx++;
+	}
+}
+EXPORT_SYMBOL_GPL(blk_persistent_dma_sync);
+
+bool blk_persistent_dma_has_iova(const struct blk_persistent_dma *dma)
+{
+	return dma && dma_use_iova(&dma->state);
+}
+EXPORT_SYMBOL_GPL(blk_persistent_dma_has_iova);
+
+dma_addr_t blk_persistent_dma_iova_base(const struct blk_persistent_dma *dma)
+{
+	return dma->state.addr;
+}
+EXPORT_SYMBOL_GPL(blk_persistent_dma_iova_base);
+
+dma_addr_t blk_persistent_dma_addr_at(const struct blk_persistent_dma *dma,
+				      unsigned int bvec_idx,
+				      size_t bvec_offset)
+{
+	if (dma_use_iova(&dma->state))
+		return dma->state.addr; /* caller must add buf_offset */
+	return dma->seg_addrs[bvec_idx] + bvec_offset;
+}
+EXPORT_SYMBOL_GPL(blk_persistent_dma_addr_at);
+
+size_t blk_persistent_dma_buf_offset(const struct blk_persistent_dma *dma,
+				     const struct bio *bio)
+{
+	unsigned int idx = bio->bi_iter.bi_idx;
+	size_t off = bio->bi_iter.bi_bvec_done;
+
+	if (!idx)
+		return off;
+	return bio->bi_io_vec[0].bv_len +
+	       ((size_t)(idx - 1) << dma->folio_shift) + off;
+}
+EXPORT_SYMBOL_GPL(blk_persistent_dma_buf_offset);
+
+unsigned int blk_persistent_dma_nr_segs(const struct blk_persistent_dma *dma)
+{
+	return dma->nr_segs;
+}
+EXPORT_SYMBOL_GPL(blk_persistent_dma_nr_segs);
+
+unsigned int blk_persistent_dma_folio_shift(const struct blk_persistent_dma *dma)
+{
+	return dma->folio_shift;
+}
+EXPORT_SYMBOL_GPL(blk_persistent_dma_folio_shift);
+
+size_t blk_persistent_dma_len(const struct blk_persistent_dma *dma)
+{
+	return dma->len;
+}
+EXPORT_SYMBOL_GPL(blk_persistent_dma_len);
+
+struct device *blk_persistent_dma_dev(const struct blk_persistent_dma *dma)
+{
+	return dma->dma_dev;
+}
+EXPORT_SYMBOL_GPL(blk_persistent_dma_dev);
+
+void *blk_persistent_dma_driver_priv(const struct blk_persistent_dma *dma)
+{
+	return dma->driver_priv;
+}
+EXPORT_SYMBOL_GPL(blk_persistent_dma_driver_priv);
+
+void blk_persistent_dma_set_driver_priv(struct blk_persistent_dma *dma,
+					void *priv,
+					void (*destroy)(struct blk_persistent_dma *))
+{
+	dma->driver_priv = priv;
+	dma->driver_priv_destroy = destroy;
+}
+EXPORT_SYMBOL_GPL(blk_persistent_dma_set_driver_priv);
