diff --git a/include/linux/blk-persistent-dma.h b/include/linux/blk-persistent-dma.h
new file mode 100644
index 000000000000..9a0ec580f668
--- /dev/null
+++ b/include/linux/blk-persistent-dma.h
@@ -0,0 +1,132 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BLK_PERSISTENT_DMA_H
+#define _BLK_PERSISTENT_DMA_H
+
+#include <linux/types.h>
+#include <linux/dma-mapping.h>
+
+struct device;
+struct bio;
+struct request_queue;
+
+/*
+ * Opaque handle for a persistent DMA mapping. Created once at buffer
+ * registration time (e.g. by io_uring slots), consumed by block device
+ * drivers to obtain pre-computed DMA addresses without per-IO mapping.
+ *
+ * Layout is defined in block/blk-persistent-dma.c; drivers only ever
+ * deal with pointers and the public API below.
+ */
+struct blk_persistent_dma;
+
+/* Direction for cache sync operations */
+enum blk_persistent_dma_sync_dir {
+	BLK_DMA_SYNC_FOR_DEVICE,
+	BLK_DMA_SYNC_FOR_CPU,
+};
+
+/**
+ * blk_persistent_dma_map - build a persistent DMA mapping for a buffer
+ * @q: request_queue of the target device
+ * @bvecs: array of bio_vec describing the buffer
+ * @nr_bvecs: number of entries in @bvecs
+ * @folio_shift: log2 of the folio size (uniform across middle bvecs)
+ * @total_len: total buffer length in bytes
+ * @out: on success, points to the new mapping (must be released with unmap)
+ *
+ * Returns 0 on success, negative errno on failure.
+ */
+int blk_persistent_dma_map(struct request_queue *q,
+			   const struct bio_vec *bvecs,
+			   unsigned int nr_bvecs,
+			   unsigned int folio_shift,
+			   size_t total_len,
+			   struct blk_persistent_dma **out);
+
+/**
+ * blk_persistent_dma_unmap - tear down a persistent DMA mapping
+ * @dma: mapping to destroy (NULL is safe)
+ */
+void blk_persistent_dma_unmap(struct blk_persistent_dma *dma);
+
+/**
+ * blk_persistent_dma_sync - synchronise DMA buffer for CPU or device
+ * @dma: persistent DMA mapping
+ * @bio: bio describing the in-flight IO range
+ * @dir: sync direction
+ */
+void blk_persistent_dma_sync(struct blk_persistent_dma *dma,
+			     const struct bio *bio,
+			     enum blk_persistent_dma_sync_dir dir);
+
+/**
+ * blk_persistent_dma_has_iova - check if mapping uses a single IOVA range
+ * @dma: persistent DMA mapping
+ */
+bool blk_persistent_dma_has_iova(const struct blk_persistent_dma *dma);
+
+/**
+ * blk_persistent_dma_iova_base - get the base IOVA address
+ * @dma: persistent DMA mapping (must have IOVA)
+ */
+dma_addr_t blk_persistent_dma_iova_base(const struct blk_persistent_dma *dma);
+
+/**
+ * blk_persistent_dma_addr_at - get DMA address for a specific bvec
+ * @dma: persistent DMA mapping
+ * @bvec_idx: index into the original bvec array
+ * @bvec_offset: byte offset within that bvec
+ */
+dma_addr_t blk_persistent_dma_addr_at(const struct blk_persistent_dma *dma,
