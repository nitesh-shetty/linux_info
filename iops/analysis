Patch 5: 537df61b0ba9 — "nvme-pci: add support for registered IO"
================================================================================

First NVMe driver wire-up. This is the consumer side — the actual fast path
that uses the persistent DMA mapping.

Additions to nvme.h (nvme_ctrl_ops):

  struct device *(*dma_dev)(struct nvme_ctrl *ctrl);

Returns the PCI DMA device. Set on disk->queue->dma_dev in nvme_alloc_ns():

  if (ctrl->ops->dma_dev)
      disk->queue->dma_dev = ctrl->ops->dma_dev(ctrl);

nvme_pci_dma_dev() implementation:

  static struct device *nvme_pci_dma_dev(struct nvme_ctrl *ctrl)
  {
      return to_nvme_dev(ctrl)->dev;
  }

Wired into nvme_pci_ctrl_ops:
  .dma_dev = nvme_pci_dma_dev,

nvme_pci_setup_data_registered() — the fast path:

  static blk_status_t nvme_pci_setup_data_registered(struct request *req)
  {
      struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
      struct bio *bio = req->bio;
      struct io_slot_dma *dma;
      dma_addr_t dma_addr;
      unsigned int total = blk_rq_payload_bytes(req);

      if (!bio)
          return BLK_STS_AGAIN;
      dma = bio_persistent_dma(bio);
      if (!dma)
          return BLK_STS_AGAIN;

      // Three cases for getting the DMA address:

      // Case 1: IOVA (IOMMU coalesced)
      if (dma_use_iova(&dma->state)) {
          // The whole buffer is a single IOVA range
          dma_addr = dma->state.addr + io_slot_buf_offset(dma, bio);

      // Case 2: Direct path, physically contiguous
      } else if (dma->nr_segs == 1) {
          // Single DMA segment, offset within it
          dma_addr = dma->seg_addrs[0] + bio->bi_iter.bi_bvec_done;

      // Case 3: Multi-segment → can't handle directly
      } else {
          return BLK_STS_AGAIN;
      }

      // Check if it fits in 2 PRPs
      unsigned int prp1_offset = dma_addr & (NVME_CTRL_PAGE_SIZE - 1);
      if (total > NVME_CTRL_PAGE_SIZE * 2 - prp1_offset)
          return BLK_STS_AGAIN;

      // Build NVMe command with PRP1/PRP2 from the DMA address
      iod->total_len = total;
      iod->flags |= IOD_SINGLE_SEGMENT;
      iod->cmd.common.dptr.prp1 = cpu_to_le64(dma_addr);
      iod->cmd.common.dptr.prp2 = 0;
      if (total > NVME_CTRL_PAGE_SIZE - prp1_offset) {
          unsigned int first_prp_len = NVME_CTRL_PAGE_SIZE - prp1_offset;
          iod->cmd.common.dptr.prp2 = cpu_to_le64(dma_addr + first_prp_len);
      }
      return BLK_STS_OK;
  }

nvme_map_data() — tries registered path first, falls back if BLK_STS_AGAIN:

  static blk_status_t nvme_map_data(struct request *req)
  {
      blk_status_t ret;

      // Try the registered fast path
      ret = nvme_pci_setup_data_registered(req);
      if (ret != BLK_STS_AGAIN)
          return ret;

      // Fallback: clear RQF_REGISTERED so completion does normal unmap
      req->rq_flags &= ~RQF_REGISTERED;

      // Normal dma_map path follows...
      // (dma_map_page per segment via blk_rq_dma_map_iter_walk)
  }

nvme_unmap_data() — skip DMA unmap for registered IOs:

  void nvme_unmap_data(struct request *req)
  {
      if (req->rq_flags & RQF_REGISTERED)
          return;     // skip dma_unmap entirely

      // normal unmap path...
  }

nvme_complete_batch() — skip unmap callback for registered:

  void nvme_complete_batch(struct io_comp_batch *iob,
                           void (*fn)(struct request *))
  {
      rq_list_for_each(&iob->req_list, req) {
          if (!(req->rq_flags & RQF_REGISTERED))
              fn(req);    // skip the unmap callback
          nvme_complete_batch_req(req);
      }
  }

The nvme.h include line in pci.c:

  #include <linux/io_uring_types.h>

This is the reverse dependency! pci.c needs the full definition of
struct io_slot_dma to access dma->use_iova, dma->state.addr, dma->seg_addrs,
dma->nr_segs, etc. This is the cross-layer include we cleaned up in the
refactoring patch.

