Patch 1: 2c044c4a8f31 — "nvme-pci: precompute persistent PRP list for registered slots"
================================================================================

This is the top patch (last applied). It closes the final gap: making the
registered fast path work for PRP-only controllers with IOs larger than 2
NVMe pages. Without this patch, such IOs fall back to per-IO dma_map.

The PRP list is built once at slot registration time and stored in
dma->driver_priv. The per-IO fast path then sets PRP2 to point into this
precomputed list.

struct nvme_pci_persistent_prp:

  struct nvme_pci_persistent_prp {
      struct device   *dev;            // DMA device (for dma_alloc_coherent)
      void            **list_va;       // CPU virtual address of each PRP page
      dma_addr_t      *list_dma;       // DMA address of each PRP page
      unsigned int    nr_list_pages;   // how many 4K PRP pages were allocated
  };

This mirrors the standard NVMe chained PRP list layout:
  - Each "PRP page" is 4K (NVME_CTRL_PAGE_SIZE) of coherent DMA memory
  - Each PRP page holds PRPS_PER_PAGE PRP entries (typically 511 on 4K pages,
    since the last entry is used for chaining)
  - PRP entries within a page are at: list[0], list[1], ..., list[PRPS_PER_PAGE-1]
  - If the list spans multiple pages, page N's last entry (list[PRPS_PER_PAGE])
    contains the DMA address of page N+1 (chain pointer)

nvme_pci_persistent_dma_setup() — called from q->persistent_dma_setup hook:

  static int nvme_pci_persistent_dma_setup(struct request_queue *q,
                                           struct io_slot_dma *dma)
  {
      // Step 1: Determine the base DMA address
      dma_addr_t base;
      if (dma_use_iova(&dma->state))
          base = dma->state.addr;              // IOVA: single coalesced address
      else if (dma->nr_segs == 1)
          base = dma->seg_addrs[0];            // Direct: single segment
      else
          return 0;                            // Multi-segment: can't build PRP list

      // Step 2: Compute how many PRP entries we need
      unsigned int page_off = base & (NVME_CTRL_PAGE_SIZE - 1);
      dma_addr_t nvme_page_base = base & ~((dma_addr_t)NVME_CTRL_PAGE_SIZE - 1);
      unsigned int total_pages = (page_off + dma->len + NVME_CTRL_PAGE_SIZE - 1)
                                  >> NVME_CTRL_PAGE_SHIFT;

      // If the transfer fits in 1 page (PRP1 only), no list needed
      if (total_pages < 2)
          return 0;

      unsigned int nr_prps = total_pages - 1;  // PRP1 covers page 0

      // Step 3: Allocate the PRP list structure
      struct nvme_pci_persistent_prp *ppp = kzalloc(sizeof(*ppp), GFP_KERNEL_ACCOUNT);
      ppp->dev = dma->dma_dev;
      ppp->nr_list_pages = DIV_ROUND_UP(nr_prps, PRPS_PER_PAGE);

      // Arrays to track PRP pages
      ppp->list_va = kvmalloc_array(ppp->nr_list_pages, sizeof(*ppp->list_va),
                                     GFP_KERNEL_ACCOUNT);
      ppp->list_dma = kvmalloc_array(ppp->nr_list_pages, sizeof(*ppp->list_dma),
                                      GFP_KERNEL_ACCOUNT);

      // Step 4: Allocate coherent DMA pages for the PRP list
      for (i = 0; i < ppp->nr_list_pages; i++) {
          ppp->list_va[i] = dma_alloc_coherent(ppp->dev, NVME_CTRL_PAGE_SIZE,
                                                &ppp->list_dma[i],
                                                GFP_KERNEL_ACCOUNT);
          if (!ppp->list_va[i])
              goto err_free_pages;    // clean up on failure
      }

      // Step 5: Fill in the PRP entries
      // Each entry points to page (i+1) of the data buffer
      // (page 0 is covered by PRP1 in the command itself)
      for (i = 0; i < nr_prps; i++) {
          unsigned int list_idx = i / PRPS_PER_PAGE;
          unsigned int entry_idx = i % PRPS_PER_PAGE;
          __le64 *list = ppp->list_va[list_idx];
          list[entry_idx] = cpu_to_le64(nvme_page_base +
                              (i + 1) * NVME_CTRL_PAGE_SIZE);
      }

      // Step 6: Chain non-last PRP pages
      // Each page's last entry (index PRPS_PER_PAGE) points to the next page
      for (i = 0; i + 1 < ppp->nr_list_pages; i++) {
          __le64 *list = ppp->list_va[i];
          list[PRPS_PER_PAGE] = cpu_to_le64(ppp->list_dma[i + 1]);
      }

      // Step 7: Store the PRP list in the DMA mapping's driver_priv
      dma->driver_priv = ppp;
      dma->driver_priv_destroy = nvme_pci_persistent_dma_destroy;
      return 0;

  err_free_pages:
      nvme_pci_persistent_prp_free(ppp);
      return -ENOMEM;
  }

nvme_pci_persistent_prp_free() — frees the PRP list:

  static void nvme_pci_persistent_prp_free(struct nvme_pci_persistent_prp *ppp)
  {
      if (!ppp)
          return;
      for (i = 0; i < ppp->nr_list_pages; i++)
          dma_free_coherent(ppp->dev, NVME_CTRL_PAGE_SIZE,
                            ppp->list_va[i], ppp->list_dma[i]);
      kvfree(ppp->list_va);
      kvfree(ppp->list_dma);
      kfree(ppp);
  }

nvme_pci_persistent_dma_destroy() — the destructor callback:

  static void nvme_pci_persistent_dma_destroy(struct io_slot_dma *dma)
  {
      nvme_pci_persistent_prp_free(dma->driver_priv);
      dma->driver_priv = NULL;
  }

nvme_pci_persistent_prp_ptr() — the per-IO helper to get PRP2:

  static dma_addr_t nvme_pci_persistent_prp_ptr(struct io_slot_dma *dma,
                                                dma_addr_t dma_addr,
                                                unsigned int prp1_offset)
  {
      struct nvme_pci_persistent_prp *ppp = dma->driver_priv;

      if (!ppp)
          return 0;

      // Compute which page of the transfer is the first full page
      dma_addr_t first_full_page = dma_addr + (NVME_CTRL_PAGE_SIZE - prp1_offset);

      // Compute the base (page-aligned)
      dma_addr_t base;
      if (dma_use_iova(&dma->state))
          base = dma->state.addr;
      else
          base = dma->seg_addrs[0];

      // Compute the logical index within the PRP list
      unsigned int logical_idx = (first_full_page -
              (base & ~((dma_addr_t)NVME_CTRL_PAGE_SIZE - 1)))
              >> NVME_CTRL_PAGE_SHIFT;
      logical_idx--;    // list[0] = page 1 of buffer (page 0 is PRP1)

      // Convert logical index to (page, entry) within the PRP list
      unsigned int list_idx = logical_idx / PRPS_PER_PAGE;
      unsigned int entry_idx = logical_idx % PRPS_PER_PAGE;

      // Return the DMA address of that PRP entry
      return ppp->list_dma[list_idx] + entry_idx * sizeof(__le64);
  }

Modified nvme_pci_setup_data_registered() — the updated fast path:

  static blk_status_t nvme_pci_setup_data_registered(struct request *req)
  {
      // ... same initial checks as patch 5 ...

      if (total > NVME_CTRL_PAGE_SIZE * 2 - prp1_offset) {
          struct nvme_queue *nvmeq = req->mq_hctx->driver_data;

          // Try SGL first (patch 4 path)
          if (nvmeq->qid && nvme_ctrl_sgl_supported(&nvmeq->dev->ctrl)) {
              // ... SGL descriptor path ...
              return BLK_STS_OK;
          }

          // PRP-only: use the precomputed list
          if (!dma->driver_priv)
              return BLK_STS_AGAIN;   // no list → fall back

          // Set PRP1 to the data buffer address, PRP2 to point into the
          // precomputed PRP list
          iod->cmd.common.dptr.prp1 = cpu_to_le64(dma_addr);
          iod->cmd.common.dptr.prp2 = cpu_to_le64(
              nvme_pci_persistent_prp_ptr(dma, dma_addr, prp1_offset));
          return BLK_STS_OK;
      }

      // Small IOs (≤2 pages): use inline PRP1/PRP2 as before
      // ...
  }

Wiring in core.c:

  disk->queue->persistent_dma_setup = ctrl->ops->persistent_dma_setup;

Wiring in nvme_ctrl_ops:

  .persistent_dma_setup = nvme_pci_persistent_dma_setup,

Full lifecycle:

  Slot registration:
    1. io_imu_dma_map() creates the DMA mapping
       ↳ dma_map_sg() or dma_map_page() — once
    2. q->persistent_dma_setup() called
       ↳ nvme_pci_persistent_dma_setup()
         ↳ dma_alloc_coherent() for PRP list pages
         ↳ fill PRP entries + chain pointers
         ↳ dma->driver_priv = ppp

  Every IO on that slot:
    1. nvme_map_data() tries nvme_pci_setup_data_registered() first
    2. Gets DMA address from dma (no dma_map call)
    3. If >2 pages, computes PRP2 via nvme_pci_persistent_prp_ptr()
       ↳ walks the precomputed PRP list, returns DMA addr of the right entry
    4. Sets PRP1 and PRP2 in the NVMe command
    5. Controller reads PRP list from coherent DMA memory
    6. No dma_map_page, no list walk, no per-IO allocation

  Slot unregistration:
    1. dma->driver_priv_destroy() called
       ↳ nvme_pci_persistent_dma_destroy()
         ↳ dma_free_coherent() for each PRP list page
    2. io_imu_dma_unmap() tears down DMA mapping
       ↳ dma_unmap_sg() or dma_unmap_page()

================================================================================
Cross-Cutting: The Clean Layering Refactoring
================================================================================

The original series has a reverse dependency:
  - include/linux/bio.h defines bio_persistent_dma() returning
    struct io_slot_dma * (defined in io_uring_types.h)
  - drivers/nvme/host/pci.c #includes <linux/io_uring_types.h> to access
    struct io_slot_dma members directly
  - The block queue callback persistent_dma_setup also takes struct io_slot_dma *
  - Result: drivers have a hard dependency on io_uring headers

Our refactoring fixes this by:
  1. Moving struct io_slot_dma → struct blk_persistent_dma (opaque handle)
  2. Defining the struct in block/blk-persistent-dma.c (block layer owns it)
  3. Creating include/linux/blk-persistent-dma.h with 14 accessor functions
  4. Updating all users to use the accessor API
  5. NVMe pci.c includes <linux/blk-persistent-dma.h> instead of
     <linux/io_uring_types.h>

The accessor API:
  - blk_persistent_dma_use_iova(dma)    → dma->use_iova
  - blk_persistent_dma_addr(dma)        → dma->state.addr
  - blk_persistent_dma_seg_addrs(dma)   → dma->seg_addrs
  - blk_persistent_dma_nr_segs(dma)     → dma->nr_segs
  - blk_persistent_dma_folio_shift(dma) → dma->folio_shift
  - blk_persistent_dma_dev(dma)         → dma->dma_dev
  - blk_persistent_dma_dir(dma)         → dma->dir
  - blk_persistent_dma_len(dma)         → dma->len
  - blk_persistent_dma_driver_priv(dma)      → dma->driver_priv
  - blk_persistent_dma_set_driver_priv(dma, p)   → dma->driver_priv = p
  - blk_persistent_dma_driver_priv_destroy(dma)  → dma->driver_priv_destroy
  - blk_persistent_dma_set_driver_priv_destroy(dma, fn)
  - blk_persistent_dma_map(q, imu, dir)      → io_buf_get_dma
  - blk_persistent_dma_unmap(dma)             → io_buf_put_dma
  - blk_persistent_dma_sync(dma, bio)         → io_slot_dma_sync
  - blk_persistent_dma_buf_offset(dma, bio)   → io_slot_buf_offset
  - blk_persistent_dma_setup(q, dma)          → calls q->persistent_dma_setup

Files changed by the refactoring:
  + include/linux/blk-persistent-dma.h  (new)
  + block/blk-persistent-dma.c          (new)
  M include/linux/bio.h                 (return type change)
  M include/linux/io_uring_types.h      (remove struct io_slot_dma, add include)
  M include/linux/blkdev.h              (callback signature update)
  M io_uring/slot.c                     (use blk_persistent_dma API)
  M io_uring/rsrc.h                     (remove dma_mappings list)
  M io_uring/rsrc.c                     (remove list init + WARN_ON)
  M drivers/nvme/host/pci.c             (include blk-persistent-dma.h, use API)
  M drivers/nvme/host/nvme.h            (callback signature update)
  M block/Makefile                      (add blk-persistent-dma.o)

