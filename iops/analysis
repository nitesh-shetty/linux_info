Patch 9: 665e6bd63945 — "io_uring/slot: persistent DMA mapping for registered buffers"
================================================================================

The core DMA mapping logic. This is where the persistent DMA mapping is
created — once at slot registration time — and then reused for every IO
on that slot without any dma_map/dma_unmap overhead.

io_buf_dma_map() / io_imu_dma_map():

  int io_imu_dma_map(struct io_mapped_ubuf *imu, struct io_slot_dma *dma,
                     struct device *dma_dev, enum dma_data_direction dir)
  {
      // Two strategies, chosen at registration time:
      //
      // Strategy A: IOVA (IOMMU) path
      //   - Build a scatterlist from the imu's bvecs
      //   - Call dma_map_sg(dma_dev, sg, nents, dir)
      //   - If dma_map_sg returns 1 entry → IOMMU coalesced the whole buffer
      //     dma->use_iova = true
      //     dma->state.addr = sg_dma_address(&sg[0])
      //     No per-page tracking — the IOMMU page table handles it
      //
      // Strategy B: Direct (no-IOMMU) path
      //   - If dma_map_sg returns >1 entries, or if the user disabled IOVA
      //     dma->use_iova = false
      //   - dma_map_page() each bvec individually
      //   - Store each DMA address in dma->seg_addrs[]
      //   - dma->nr_segs = number of segments

The fallback from IOVA to direct happens at registration time, not at IO time.
dma_map_sg first tries to create an IOVA mapping. If it can't coalesce (no IOMMU
or the IOMMU can't map the whole range), it returns >1 entries, and we fall
back to direct path.

  struct io_slot_dma {
      bool             use_iova;       // true = IOVA (single addr), false = direct
      union {
          struct {
              dma_addr_t addr;         // IOVA base address
          } state;
      };
      struct sg_table  sgt;           // scatter-gather table (for unmap)
      dma_addr_t       *seg_addrs;    // per-segment DMA addrs (direct path only)
      unsigned int     nr_segs;       // number of segments
      unsigned int     folio_shift;   // uniform shift, copied from imu
      size_t           len;           // total mapped length
      struct device    *dma_dev;      // device used for DMA
      enum dma_data_direction dir;    // read/write/bidirectional
  };

io_buf_dma_unmap() / io_imu_dma_unmap():

  void io_imu_dma_unmap(struct io_mapped_ubuf *imu, struct io_slot_dma *dma)
  {
      if (dma->use_iova)
          dma_unmap_sg(dma->dma_dev, dma->sgt.sgl, dma->sgt.nents, dma->dir);
      else {
          for (i = 0; i < dma->nr_segs; i++)
              dma_unmap_page(dma->dma_dev, dma->seg_addrs[i],
                             PAGE_SIZE << imu->folio_shift, dma->dir);
          kfree(dma->seg_addrs);
      }
  }

io_slot_buf_offset() — computes the byte offset of a bio's current position
relative to the persistent DMA mapping base:

  unsigned int io_slot_buf_offset(struct io_slot_dma *dma, struct bio *bio)
  {
      // For IOVA: offset = current bio position relative to buffer start
      // Uses bi_iter.bi_sector to compute byte offset within the slot
      // Uses folio_shift to determine page boundaries
  }

This is used by the NVMe fast path to adjust the DMA address by the current
IO offset (since the same DMA mapping covers the whole buffer, but each IO
only reads/writes a portion of it).

struct io_buf_dma — the refcounted wrapper:

  struct io_buf_dma {
      struct list_head   list;        // for imu->dma_mappings list
      struct io_slot_dma dma;         // the actual DMA mapping
      struct device      *dma_dev;    // DMA device
      refcount_t         refs;        // shared across slots with same (buf,dev)
  };

